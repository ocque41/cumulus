# Public browser configuration. Vite deliberately exposes only NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Server-only Resend contact, topic, and delivery configuration.
RESEND_API_KEY=replace-with-server-only-resend-key
RESEND_WEBHOOK_SECRET=replace-with-server-only-webhook-signing-secret
RESEND_NOTIFICATION_SEGMENT_ID=replace-with-resend-segment-id
RESEND_NOTIFICATION_TOPIC_ID=replace-with-resend-topic-id
NOTIFICATION_FROM_EMAIL="Cumulus <notifications@example.com>"
NOTIFICATION_POSTAL_ADDRESS="replace-with-valid-postal-address"

# Optional server-only GitHub GraphQL access for the fixed ocque41 graph.
# Leave empty to use the bounded public-profile calendar. Never use a broad
# owner, private-repository, or workflow token for this public display.
GITHUB_ACCESS_TOKEN=

# Server-only authorization and token-signing secrets. Use independent,
# cryptographically random values in every environment.
NOTIFICATION_PUBLISH_SECRET=replace-with-strong-publish-secret
NOTIFICATION_UNSUBSCRIBE_SECRET=replace-with-strong-notification-session-secret

# Deployment credentials are intentionally absent. Keep Vercel, Resend, and
# other operator credentials in their provider, an approved secret manager, or
# an authenticated CLI session; never store real values in this public repo.
