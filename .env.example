# Public deployment mode: cloud or self_hosted.
CUMULUS_DEPLOYMENT_MODE=cloud
LOG_LEVEL=info

# Public site URL. This is safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/cumulus/cumulus

# Supabase-compatible auth/database configuration.
# These NEXT_PUBLIC values are visible in the browser. Use only public anon keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Shared auth behavior.
FEDERATED_ALLOWED_ROOTS=localhost
FEDERATED_LOCAL_HOSTS=localhost,127.0.0.1
AUTH_COOKIE_DOMAIN=auto
AUTH_COOKIE_SECURE_MODE=auto

# Optional auth telemetry. Leave blank for self-hosted installs that do not use it.
AUTH_TELEMETRY_INGEST_URL=
AUTH_TELEMETRY_INGEST_SECRET=
AUTH_TELEMETRY_HASH_SALT=

# Cumulus Cloud/API path. Use this when Cumulus hosts operational services for you.
CUMULUS_CLOUD_API_URL=https://api.cumulush.com
CUMULUS_CLOUD_API_KEY=replace-with-cloud-api-key

# Self-hosted Cumulus DB path. The master key is server-only and must never be sent to the browser.
CUMULUS_DB_PUBLIC_URL=http://localhost:4317
CUMULUS_DB_INTERNAL_URL=http://localhost:4317
CUMULUS_DB_MASTER_KEY=replace-with-32-byte-base64-key
CUMULUS_DB_ADMIN_API_ENABLED=false

# Optional Stripe billing. Use server-only price IDs and secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY_USD=
STRIPE_PRICE_ID_PRO_MONTHLY_EUR=
STRIPE_PRICE_ID_PRO_MONTHLY_GBP=

# Optional Relay login integration for self-hosted deployments.
RELAY_ENDPOINT=
RELAY_ISSUER=
RELAY_TENANT_ID=
