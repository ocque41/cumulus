# ------------------------------------------------------------
# Dependencies (Node, npm, pnpm, yarn)
# ------------------------------------------------------------
node_modules/

# Yarn Berry (PnP)
/.pnp
.pnp.*
/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
# Yarn generated caches (safe to ignore unless you intentionally use Zero-Installs)
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# pnpm
.pnpm-store/

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------
# Testing / Coverage
# ------------------------------------------------------------
coverage/
.nyc_output/
test-results/
sessions/

# ------------------------------------------------------------
# Next.js / React frameworks
# ------------------------------------------------------------
.next/
out/
dist/
build/
.swc/

# ------------------------------------------------------------
# Env files (keep examples)
# ------------------------------------------------------------
.env*
!.env.example
!.env.*.example

# ------------------------------------------------------------
# Vercel
# ------------------------------------------------------------
.vercel/
.vercel/output/

# ------------------------------------------------------------
# Tooling caches
# ------------------------------------------------------------
.cache/
.turbo/
.playwright-mcp/
.eslintcache
.stylelintcache
.parcel-cache/

# ------------------------------------------------------------
# TypeScript
# ------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------
# IDE / Editor
# ------------------------------------------------------------
.idea/
*.swp
*.swo

# VS Code
.vscode/
*.code-workspace

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
*.pem

# ------------------------------------------------------------
# Local release-prep scratch
# ------------------------------------------------------------
# Raw reference/design asset drops can be large and duplicated. Commit only the
# curated runtime copies that the app imports, such as public/create/ and
# src/fonts/.
/assets/
/GOAL.md
/.tmp-*

# Cumulus Database local runtime data. This folder may contain user records,
# encrypted secrets, tokens, segments, and snapshots. Never commit it.
.cumulus-db-data/
apps/cumulus-db/.cumulus-db-data/
apps/cumulus-db/dist/

# ------------------------------------------------------------
# Optional: ignore local-only MCP tooling
# ------------------------------------------------------------
/mcp/
/mcp.json

# ------------------------------------------------------------
# Local/private agent tooling. Keep public guidance in AGENTS.md and CLAUDE.md.
# ------------------------------------------------------------
.agent/
.agents/
.claude/
.codex/

# ------------------------------------------------------------
# Private package artifacts do not belong in the public repo.
# ------------------------------------------------------------
vendor/*.tgz

# ------------------------------------------------------------
# Video rendering / frame capture (web-to-video skill)
# ------------------------------------------------------------
# Puppeteer + ffmpeg pipeline writes thousands of PNG frames into tmp/ and
# multi-hundred-MB ProRes masters alongside them. Final deliverables go to
# ~/Downloads/ — never check the rendering scratch into the repo.
tmp/
**/*-frames/
**/*-video-frames/
*-MASTER.mov
*-MASTER.mp4
*.prores
