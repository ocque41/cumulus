{
  "name": "cumulus",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/registry/build.mjs && next build",
    "start": "next start",
    "db:build": "npm --prefix apps/cumulus-db run build",
    "db:dev": "npm --prefix apps/cumulus-db run dev",
    "db:start": "npm --prefix apps/cumulus-db run start",
    "db:test": "npm --prefix apps/cumulus-db run test",
    "db:smoke": "npm --prefix apps/cumulus-db run build && npm --prefix apps/cumulus-db run smoke",
    "lint": "eslint",
    "test": "vitest run && npm run terminal:test",
    "terminal": "node packages/terminal-site/bin/cumulus.js",
    "terminal:test": "node --test packages/terminal-site/test/*.test.mjs",
    "terminal:pack": "npm pack --dry-run ./packages/terminal-site",
    "test:e2e": "playwright test",
    "legal:lint": "node scripts/legal/validate.mjs",
    "legal:links": "node scripts/legal/check-links.mjs",
    "docs:lint": "node scripts/docs/validate.mjs",
    "marketing:lint": "node scripts/marketing/validate.mjs",
    "license:check": "node scripts/security/license-boundary-check.mjs",
    "security:scan": "node scripts/security/public-safety-scan.mjs",
    "public:export": "node scripts/release/create-public-export.mjs"
  },
