{
  "name": "cumulus",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-vercel-config.mjs && npm run typecheck && vite build && node scripts/generate-static-routes.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.vercel.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --audit-level=high",
    "security:scan": "node scripts/security-scan.mjs",
    "license:check": "node scripts/license-check.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run license:check && npm run build && npm run security:scan && npm run audit:deps"
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.77",
    "@vercel/analytics": "1.6.1",
    "@vercel/speed-insights": "1.3.1",
    "dither-plugin": "1.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.17.2",
    "svix": "1.97.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.0",
    "@tailwindcss/vite": "4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "27.0.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
