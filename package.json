{
  "name": "cumulus",
  "version": "0.0.7",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/registry/build.mjs && next build",
    "start": "next start",
    "db:build": "npm --prefix apps/cumulus-db run build",
    "db:dev": "npm --prefix apps/cumulus-db run dev",
    "db:start": "npm --prefix apps/cumulus-db run start",
    "db:test": "npm --prefix apps/cumulus-db run test",
    "db:test:postgres": "npm --prefix apps/cumulus-db run test:postgres",
    "db:smoke": "npm --prefix apps/cumulus-db run build && npm --prefix apps/cumulus-db run smoke",
    "db:smoke:postgres": "npm --prefix apps/cumulus-db run build && npm --prefix apps/cumulus-db run smoke:postgres",
    "db:cli": "npm --prefix apps/cumulus-db run cumulus --",
    "typecheck": "tsc --noEmit && npm --prefix apps/cumulus-db run build",
    "lint": "eslint",
    "test": "vitest run && npm run terminal:test",
    "terminal": "node packages/terminal-site/bin/cumulus.js",
    "terminal:test": "node --test packages/terminal-site/test/*.test.mjs",
    "terminal:pack": "npm pack --dry-run ./packages/terminal-site",
    "test:e2e": "playwright test",
    "legal:lint": "node scripts/legal/validate.mjs",
    "legal:links": "node scripts/legal/check-links.mjs",
    "docs:lint": "node scripts/docs/validate.mjs",
    "marketing:lint": "node scripts/marketing/validate.mjs",
    "license:check": "node scripts/security/license-boundary-check.mjs",
    "security:scan": "node scripts/security/public-safety-scan.mjs",
    "public:export": "node scripts/release/create-public-export.mjs"
  },
  "dependencies": {
    "@cumulus/auth": "file:./packages/auth",
    "@playwright/test": "^1.56.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@shopify/shopify-api": "^12.2.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.91.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^20",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.2",
    "linkinator": "^7.1.3",
    "lucide-react": "^0.544.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.2.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "remark-gfm": "^4.0.1",
    "remark-slug": "^7.0.1",
    "sonner": "^2.0.7",
    "stripe": "^17.6.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "unist-util-visit": "^5.0.0",
    "vitest": "^3.2.4",
    "zod": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6"
  }
}
